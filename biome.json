{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**/*.ts", "**/*.json", "**/*.jsonc"] },
  "formatter": { "enabled": true, "useEditorconfig": true, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "domains": { "test": "recommended" },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExtraBooleanCast": "error",
        "noFlatMapIdentity": "error",
        "noUselessCatch": "error",
        "noUselessConstructor": "error",
        "noUselessContinue": "error",
        "noUselessEmptyExport": "error",
        "noUselessEscapeInRegex": "error",
        "noUselessLabel": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessRename": "error",
        "noUselessStringRaw": "error",
        "noUselessSwitchCase": "error",
        "noUselessTernary": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "noUselessUndefinedInitialization": "error",
        "useFlatMap": "error",
        "useIndexOf": "error",
        "useLiteralKeys": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        },
        "noForEach": "error",
        "noImplicitCoercions": "error",
        "noUnnecessaryTemplateExpression": "error",
        "noUselessCatchBinding": "error",
        "noUselessReturn": "error",
        "noUselessStringConcat": "error",
        "noUselessUndefined": "error",
        "noVoid": "error",
        "useArrayFind": "error",
        "useArraySome": "error",
        "useMaxParams": { "level": "error", "options": { "max": 4 } },
        "useRegexpTest": "error",
        "useSimplifiedLogicExpression": "error",
        "useWhile": "error",
        "noStaticOnlyClass": "off"
      },
      "correctness": {
        "useParseIntRadix": "error",
        "noGlobalDirnameFilename": "error",
        "noUndeclaredDependencies": "error",
        "useImportExtensions": "error",
        "useJsonImportAttributes": "error"
      },
      "performance": {
        "noBarrelFile": "error",
        "noDelete": "error",
        "noNamespaceImport": "error",
        "noReExportAll": "error",
        "useTopLevelRegex": "error"
      },
      "security": { "noSecrets": "error" },
      "style": {
        "noNonNullAssertion": "error",
        "useArrayLiterals": "error",
        "useConst": "error",
        "useExponentiationOperator": "error",
        "useExportType": "error",
        "useImportType": { "level": "error", "options": { "style": "separatedType" } },
        "useNodejsImportProtocol": "error",
        "useShorthandFunctionType": "error",
        "useTemplate": "error",
        "noCommonJs": "error",
        "noDefaultExport": "error",
        "noEnum": "error",
        "noExportedImports": "error",
        "noIncrementDecrement": "error",
        "noInferrableTypes": "error",
        "noMultiAssign": "error",
        "noMultilineString": "error",
        "noNamespace": "error",
        "noNegationElse": "error",
        "noNestedTernary": "error",
        "noParameterAssign": "error",
        "noParameterProperties": "error",
        "noShoutyConstants": "error",
        "noSubstr": "error",
        "noUnusedTemplateLiteral": "error",
        "noUselessElse": "error",
        "noYodaExpression": "error",
        "useAsConstAssertion": "error",
        "useAtIndex": "error",
        "useBlockStatements": "error",
        "useCollapsedElseIf": "error",
        "useCollapsedIf": "error",
        "useConsistentArrayType": { "level": "error", "options": { "syntax": "shorthand" } },
        "useConsistentArrowReturn": { "level": "error", "options": { "style": "asNeeded" } },
        "useConsistentBuiltinInstantiation": "error",
        "useConsistentMemberAccessibility": {
          "level": "error",
          "options": { "accessibility": "noPublic" }
        },
        "useConsistentMethodSignatures": { "level": "error", "options": { "style": "property" } },
        "useConsistentObjectDefinitions": {
          "level": "error",
          "options": { "syntax": "shorthand" }
        },
        "useConsistentTypeDefinitions": { "level": "error", "options": { "style": "type" } },
        "useDefaultParameterLast": "error",
        "useErrorCause": "error",
        "useExplicitLengthCheck": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["kebab-case"], "requireAscii": true }
        },
        "useForOf": "error",
        "useGroupedAccessorPairs": "error",
        "useImportsFirst": "error",
        "useNamingConvention": {
          "level": "error",
          "options": { "strictCase": true, "requireAscii": true }
        },
        "useNodeAssertStrict": "error",
        "useNumberNamespace": "error",
        "useNumericSeparators": "error",
        "useObjectSpread": "error",
        "useReadonlyClassProperties": "error",
        "useReduceTypeParameter": "error",
        "useShorthandAssign": "error",
        "useSingleVarDeclarator": "error",
        "useSpreadOverApply": "error",
        "useSymbolDescription": "error",
        "useThisInClassMethods": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error",
        "useTrimStartEnd": "error",
        "useUnicodeRegex": "error",
        "useUnifiedTypeSignatures": "error",
        "useExportsLast": "error"
      },
      "suspicious": {
        "noBitwiseOperators": "error",
        "noConsole": { "level": "error", "options": { "allow": ["error", "log", "warn"] } },
        "noConstantBinaryExpressions": "error",
        "noDeprecatedImports": "error",
        "noEmptyBlockStatements": "error",
        "noEqualsToNull": "error",
        "noEvolvingTypes": "error",
        "noForIn": "error",
        "noImportCycles": "error",
        "noLoopFunc": "error",
        "noNestedPromises": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noReturnAssign": "error",
        "noShadow": "error",
        "noUnassignedVariables": "error",
        "noUnnecessaryConditions": "error",
        "noUnusedExpressions": "error",
        "noVar": "error",
        "useArraySortCompare": "error",
        "useAwait": "error",
        "useErrorMessage": "error",
        "useNumberToFixedDigitsArgument": "error",
        "useStaticResponseMethods": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error",
        "noUselessAwait": "error",
        "useExhaustiveSwitchCases": {
          "level": "error",
          "options": { "requireExplicitCase": true }
        },
        "useExplicitReturnType": {
          "level": "error",
          "options": { "allowExpressions": true, "allowIifes": false }
        },
        "useConsistentFunctionStyle": { "level": "error", "options": { "style": "expression" } },
        "useStrictBooleanExpressions": "error",
        "noUnsafeTypeAssertion": "error",
        "useNullishCoalescing": "error",
        "noUnsafePlusOperands": "error",
        "noBaseToString": "error",
        "noUselessTypeAssertion": "error",
        "noUselessTypeConversion": "error",
        "useIncludes": "error",
        "useStringStartsEndsWith": "error",
        "noPromiseExecutorReturn": "error",
        "usePromiseRejectErrors": "error",
        "noMissingThrow": "error",
        "noImpliedEval": "error",
        "noUselessAssignment": "error",
        "noProcessExit": "error"
      }
    }
  },
  "plugins": [
    "./biome/no-long-chains.grit",
    "./biome/no-array-reduce.grit",
    "./biome/switch-case-braces.grit",
    "./biome/await-position.grit",
    "./biome/single-export.grit",
    "./biome/entity-file-name.grit"
  ]
}
